APP_NAME="E-Presensi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apk_absensi
DB_USERNAME=root
DB_PASSWORD=

# ─── Session & Cache ──────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Konfigurasi Sekolah ──────────────────────────────────────────────────────
# Koordinat GPS sekolah (latitude, longitude)
SCHOOL_LATITUDE=-7.671325
SCHOOL_LONGITUDE=110.589607
# Radius maksimum absensi dalam meter
SCHOOL_RADIUS_METERS=100
SCHOOL_NAME="SMK Negeri 1"

VITE_APP_NAME="${APP_NAME}"

# ─── Digifest 2026 Competition Feature Flags ──────────────────────────────────
# SEMUA FLAG DEFAULT FALSE. Jika semua false, aplikasi identik dengan versi klien.
# Aktifkan HANYA di instance Railway lomba, JANGAN di production klien.
FEATURE_TRUST_ENGINE_SHADOW=false
FEATURE_TRUST_ENGINE_ENFORCE=false
FEATURE_COMPETITION_NAV=false
FEATURE_COMPETITION_CONSENT=false
COMPETITION_CONSENT_TEXT_APPROVED=false
COMPETITION_CONSENT_CONTACT=
FEATURE_AI_EVALUATION_DASHBOARD=false
FEATURE_COMPETITION_AUDIT_VIEWER=false
FEATURE_COMPETITION_DATA_ERASURE=false
COMPETITION_VERSION=
COMPETITION_COMMIT=
COMPETITION_TRUST_SCORE_RETENTION_DAYS=90
COMPETITION_LIVENESS_RETENTION_DAYS=90
COMPETITION_AUDIT_RETENTION_DAYS=90
COMPETITION_CONSENT_HISTORY_RETENTION_DAYS=365
COMPETITION_EVALUATION_RETENTION_DAYS=180
COMPETITION_MANUAL_VERIFICATION_RETENTION_DAYS=90
COMPETITION_CHALLENGE_TTL_SECONDS=90
COMPETITION_DEMO_PASSWORD=
COMPETITION_JUDGE_EMAIL=
COMPETITION_JUDGE_PASSWORD=
